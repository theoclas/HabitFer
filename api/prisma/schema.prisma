generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ScheduleType {
  DAILY
  WEEKLY
  /// X veces por semana, sin dias fijos (Habit.weeklyTarget).
  WEEKLY_COUNT
}

enum HabitKind {
  /// Hacer algo (lo normal).
  BUILD
  /// Dejar algo: cuenta los dias limpio y registra recaidas.
  QUIT
}

/// Momento del dia en que se agrupa el habito en la pantalla Hoy.
enum TimeOfDay {
  ANYTIME
  MORNING
  AFTERNOON
  EVENING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                    String                 @id @default(cuid())
  email                 String                 @unique
  username              String                 @unique @db.VarChar(64)
  passwordHash          String
  fullName              String                 @db.VarChar(120)
  role                  UserRole               @default(USER)
  status                UserStatus             @default(ACTIVE)
  approvedAt            DateTime?
  approvedById          String?
  approvedBy            User?                  @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers         User[]                 @relation("UserApprovals")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  habits                Habit[]
  completions           HabitCompletion[]
  habitAchievements     HabitAchievement[]
  projects              Project[]
  tasks                 Task[]
  reminders             ReminderLog[]
  ownedWorkspaces       Workspace[]            @relation("WorkspaceOwner")
  workspaceMemberships  WorkspaceMember[]
  collabTasksCreated    CollabTask[]           @relation("CollabTaskCreator")
  collabTasksAssigned   CollabTask[]           @relation("CollabTaskAssignee")
  collabTaskCompletions CollabTaskCompletion[]
  comments              Comment[]
  activityLogs          ActivityLog[]
  collabProjectMembers  CollabProjectMember[]
  collabNotifications   CollabNotification[]
  workGuidesCreated     WorkGuide[]            @relation("WorkGuideCreator")
  financeAccounts       FinanceAccount[]
  incomes               Income[]
  credits               Credit[]
  financeCategories     FinanceCategory[]
  financeTransactions   FinanceTransaction[]
  financeKeywords       FinanceKeyword[]
  financeShortcuts      FinanceShortcut[]
  dayMoods              DayMood[]
  pushSubscriptions     PushSubscription[]
  habitProgress         HabitProgress[]
  habitRelapses         HabitRelapse[]
  streakFreezes         StreakFreeze[]
  habitPauses           HabitPause[]
  challengeResults      ChallengeResult[]
  coachMessages         CoachMessage[]
  foods                 Food[]
  mealEntries           MealEntry[]
  nutritionProfile      NutritionProfile?
  foodFavorites         FoodFavorite[]
  savedMeals            SavedMeal[]
  nutritionDays         NutritionDay[]
  foodAliases           FoodAlias[]
  mealPhotos            MealPhoto[]
  bodyWeights           BodyWeight[]
  energyEstimates       EnergyEstimate[]
  nutritionShortcut     NutritionShortcut?
  nutritionAgentKeys    NutritionAgentKey[]
  fasts                 Fast[]
  mealPlanItems         MealPlanItem[]
  fitRoutines           FitRoutine[]
  fitWorkouts           FitWorkout[]
  fitSettings           FitSettings?
  /// Coach semanal con IA (si el servidor tiene la llave). false = no escribirle.
  coachEnabled          Boolean                @default(true)
  /// Hora (HH:mm) del resumen nocturno de habitos por push; null = apagado.
  habitSummaryTime      String?                @db.VarChar(5)
  /// Hora (HH:mm) del mensaje de la mañana (lo de hoy, la racha y una frase); null = apagado.
  morningTime           String?                @db.VarChar(5)
  /// Que avisos llegan tambien por correo (a User.email).
  emailReminders        ReminderLevel          @default(OFF)
  /// Que avisos llegan tambien por WhatsApp (a sus WhatsappNumber, maximo 2).
  whatsappReminders     ReminderLevel          @default(OFF)
  whatsappNumbers       WhatsappNumber[]
}

/// Nivel de avisos de un canal (correo o WhatsApp): OFF nada; SUMMARY el resumen de la noche y el coach;
/// ALL ademas cada recordatorio de habitos y tareas.
enum ReminderLevel {
  OFF
  SUMMARY
  ALL
}

/// Numero de WhatsApp que recibe los avisos de un usuario (maximo 2 por usuario).
model WhatsappNumber {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Solo digitos, con indicativo de pais: 573001234567.
  phone     String   @db.VarChar(20)
  createdAt DateTime @default(now())

  @@unique([userId, phone])
}

/// Enlace corto del boton «Hecho» de WhatsApp: /a/<code> lleva a /accion con el token completo (36 h).
model ActionLink {
  code      String   @id @db.VarChar(16)
  token     String   @db.Text
  title     String   @db.VarChar(120)
  label     String   @db.VarChar(60)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Suscripcion Web Push de un dispositivo (telefono o computador).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique @db.VarChar(700)
  p256dh     String    @db.VarChar(200)
  auth       String    @db.VarChar(100)
  userAgent  String?   @db.VarChar(300)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

/// Animo del dia (1 a 5) para cruzarlo con la constancia en Estadisticas.
model DayMood {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  mood      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

enum ReminderSourceType {
  HABIT
  TASK
  SUMMARY
  /// Mensaje de la mañana.
  MORNING
}

model ReminderLog {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceType ReminderSourceType
  sourceId   String             @db.VarChar(64)
  title      String             @db.VarChar(200)
  body       String?            @db.VarChar(500)
  triggerAt  DateTime
  readAt     DateTime?
  createdAt  DateTime           @default(now())

  @@index([userId, readAt])
  @@index([sourceType, sourceId, triggerAt])
}

model Habit {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String             @db.VarChar(120)
  description      String?            @db.VarChar(500)
  color            String             @default("#22d3ee") @db.VarChar(7)
  icon             String?            @db.VarChar(32)
  archived         Boolean            @default(false)
  scheduleType     ScheduleType       @default(DAILY)
  scheduleDays     Json               @default("[1,2,3,4,5,6,7]")
  /// WEEKLY_COUNT: cuantas veces por semana (1 a 7).
  weeklyTarget     Int?
  timeOfDay        TimeOfDay          @default(ANYTIME)
  /// BUILD = hacer algo; QUIT = dejar algo (dias limpio y recaidas).
  kind             HabitKind          @default(BUILD)
  /// Meta del dia: 1 = si/no; mayor que 1 = habito medible (8 vasos, 30 minutos).
  goal             Int                @default(1)
  /// Unidad de la meta (vasos, minutos, paginas).
  unit             String?            @db.VarChar(20)
  /// Cuanto suma cada toque en un habito medible.
  step             Int                @default(1)
  /// QUIT: primer dia limpio (puede ser anterior a la creacion).
  startDate        DateTime?          @db.Date
  /// Reto: cuantos dias dura y su primer dia (null = sin reto).
  challengeDays    Int?
  challengeStart   DateTime?          @db.Date
  streakEnabled    Boolean            @default(true)
  reminderEnabled  Boolean            @default(false)
  /// Primera hora de aviso (se mantiene por compatibilidad); la lista completa va en reminderTimes.
  reminderTime     String?            @db.VarChar(5)
  /// Todas las horas de aviso (HH:mm), hasta 4.
  reminderTimes    Json               @default("[]")
  /// Se marca solo desde NutriFer: NUTRI_LOG (anotar las comidas), NUTRI_PROTEIN, NUTRI_WATER o NUTRI_FAST (null = a mano).
  autoSource       String?            @db.VarChar(20)
  sortOrder        Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  completions      HabitCompletion[]
  achievements     HabitAchievement[]
  progress         HabitProgress[]
  relapses         HabitRelapse[]
  freezes          StreakFreeze[]
  pauses           HabitPause[]
  challengeResults ChallengeResult[]

  @@index([userId, archived])
}

model HabitAchievement {
  id            String   @id @default(cuid())
  habitId       String
  habit         Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneDays Int
  phraseIndex   Int
  unlockedAt    DateTime @default(now())

  @@unique([habitId, milestoneDays])
  @@index([userId, habitId])
}

model HabitCompletion {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

/// Cantidad del dia en un habito medible. El HabitCompletion existe solo si se llego a la meta.
model HabitProgress {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  value     Int
  /// Nota del dia mientras no se llega a la meta (al llegar pasa al completado).
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([habitId, date])
  @@index([userId, date])
}

/// Recaida de un habito para dejar (QUIT): ese dia no fue limpio.
model HabitRelapse {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  note      String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId, date])
}

/// Congelador gastado: ese dia no cuenta ni rompe la racha del habito.
model StreakFreeze {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([habitId, date])
  @@index([userId])
}

/// Pausa (vacaciones, enfermedad): esos dias no cuentan ni rompen rachas. habitId null = todos.
model HabitPause {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId   String?
  habit     Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?  @db.VarChar(120)
  createdAt DateTime @default(now())

  @@index([userId, endDate])
  @@index([habitId])
}

/// Mensaje semanal del coach (Claude) para un usuario: uno por semana (lunes de esa semana).
model CoachMessage {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime  @db.Date
  text         String    @db.Text
  model        String    @db.VarChar(60)
  inputTokens  Int       @default(0)
  outputTokens Int       @default(0)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@unique([userId, weekStart])
}

/// Reto cumplido: queda como medalla aunque el habito siga o se borre el reto.
model ChallengeResult {
  id          String   @id @default(cuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days        Int
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  phraseIndex Int
  wonAt       DateTime @default(now())

  @@unique([habitId, startDate])
  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  color     String   @default("#38bdf8") @db.VarChar(7)
  sortOrder Int      @default(0)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@index([userId, archived])
}

model Task {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title           String       @db.VarChar(200)
  description     String?      @db.VarChar(1000)
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?    @db.Date
  dueTime         String?      @db.VarChar(5)
  reminderEnabled Boolean      @default(false)
  reminderAt      DateTime?
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
  @@index([projectId])
}

// --- ProyecFer (colaboracion) ---

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum CommentTargetType {
  COLLAB_TASK
  COLLAB_PROJECT
  PAGE
  WORK_GUIDE
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  STATUS_CHANGED
  ASSIGNED
  COMMENTED
  MEMBER_ADDED
  MEMBER_REMOVED
  ROLE_CHANGED
  COMPLETED
  UNCOMPLETED
}

enum BlockType {
  paragraph
  heading_1
  heading_2
  heading_3
  bulleted_list
  numbered_list
  todo
  divider
  callout
  code
}

enum DatabasePropertyType {
  TEXT
  NUMBER
  SELECT
  MULTI_SELECT
  DATE
  PERSON
  CHECKBOX
  URL
  RELATION
}

enum DatabaseViewType {
  TABLE
  BOARD
  CALENDAR
  GALLERY
}

model Workspace {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(120)
  description String?           @db.VarChar(500)
  icon        String?           @db.VarChar(32)
  ownerId     String
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  members     WorkspaceMember[]
  projects    CollabProject[]
  pages       Page[]
  tasks       CollabTask[]
  activity    ActivityLog[]
  workGuides  WorkGuide[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(EDITOR)
  joinedAt    DateTime      @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollabProject {
  id          String                @id @default(cuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String                @db.VarChar(120)
  description String?               @db.VarChar(1000)
  color       String                @default("#3b82f6") @db.VarChar(7)
  archived    Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  tasks       CollabTask[]
  pages       Page[]
  members     CollabProjectMember[]
  activity    ActivityLog[]
  workGuides  WorkGuide[]

  @@index([workspaceId, archived])
}

model CollabProjectMember {
  id        String        @id @default(cuid())
  projectId String
  project   CollabProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      WorkspaceRole @default(EDITOR)

  @@unique([projectId, userId])
}

enum CollabTaskKind {
  ONE_OFF
  DAILY
}

model CollabTask {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId     String
  project       CollabProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String                 @db.VarChar(200)
  description   String?                @db.VarChar(2000)
  kind          CollabTaskKind         @default(ONE_OFF)
  status        TaskStatus             @default(TODO)
  priority      TaskPriority           @default(MEDIUM)
  assigneeId    String?
  assignee      User?                  @relation("CollabTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User                   @relation("CollabTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  dueDate       DateTime?              @db.Date
  dueTime       String?                @db.VarChar(5)
  activeFrom    DateTime?              @db.Date
  sourceDailyId String?
  sourceDaily   CollabTask?            @relation("DailyInstances", fields: [sourceDailyId], references: [id], onDelete: Cascade)
  instances     CollabTask[]           @relation("DailyInstances")
  scheduledDate DateTime?              @db.Date
  sortOrder     Int                    @default(0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  completions   CollabTaskCompletion[]

  @@unique([sourceDailyId, scheduledDate])
  @@index([workspaceId, status])
  @@index([projectId])
  @@index([assigneeId])
  @@index([projectId, kind])
  @@index([sourceDailyId, scheduledDate])
}

model CollabTaskCompletion {
  id            String     @id @default(cuid())
  taskId        String
  task          CollabTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  date          DateTime   @db.Date
  completedById String
  completedBy   User       @relation(fields: [completedById], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([taskId, date])
  @@index([taskId, date])
}

model Page {
  id           String         @id @default(cuid())
  workspaceId  String
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String?
  project      CollabProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentPageId String?
  parentPage   Page?          @relation("PageTree", fields: [parentPageId], references: [id], onDelete: Cascade)
  childPages   Page[]         @relation("PageTree")
  title        String         @db.VarChar(200)
  icon         String?        @db.VarChar(32)
  coverUrl     String?        @db.VarChar(500)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  blocks       Block[]
  database     Database?
  databaseRow  DatabaseRow?

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentPageId])
}

model Block {
  id            String    @id @default(cuid())
  pageId        String
  page          Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type          BlockType @default(paragraph)
  content       Json      @default("{}")
  sortOrder     Int       @default(0)
  parentBlockId String?
  parentBlock   Block?    @relation("BlockTree", fields: [parentBlockId], references: [id], onDelete: Cascade)
  childBlocks   Block[]   @relation("BlockTree")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([pageId, sortOrder])
}

model Database {
  id         String             @id @default(cuid())
  pageId     String             @unique
  page       Page               @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title      String             @db.VarChar(120)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  properties DatabaseProperty[]
  rows       DatabaseRow[]
  views      DatabaseView[]
}

model DatabaseProperty {
  id         String               @id @default(cuid())
  databaseId String
  database   Database             @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String               @db.VarChar(80)
  type       DatabasePropertyType
  config     Json                 @default("{}")
  sortOrder  Int                  @default(0)

  @@index([databaseId])
}

model DatabaseRow {
  id         String   @id @default(cuid())
  databaseId String
  database   Database @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  pageId     String   @unique
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  values     Json     @default("{}")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([databaseId])
}

model DatabaseView {
  id         String           @id @default(cuid())
  databaseId String
  database   Database         @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  name       String           @db.VarChar(80)
  type       DatabaseViewType @default(TABLE)
  config     Json             @default("{}")
  sortOrder  Int              @default(0)

  @@index([databaseId])
}

model Comment {
  id              String            @id @default(cuid())
  targetType      CommentTargetType
  targetId        String            @db.VarChar(64)
  authorId        String
  author          User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body            String            @db.VarChar(2000)
  parentCommentId String?
  parentComment   Comment?          @relation("CommentThread", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]         @relation("CommentThread")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([targetType, targetId])
  @@index([authorId])
}

model ActivityLog {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String?
  project     CollabProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId     String
  actor       User           @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action      ActivityAction
  targetType  String?        @db.VarChar(40)
  targetId    String?        @db.VarChar(64)
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
}

enum CollabNotificationType {
  TASK_ASSIGNED
  COMMENT_MENTION
  ROLE_CHANGED
}

model CollabNotification {
  id        String                 @id @default(cuid())
  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      CollabNotificationType
  title     String                 @db.VarChar(200)
  body      String?                @db.VarChar(500)
  metadata  Json                   @default("{}")
  readAt    DateTime?
  createdAt DateTime               @default(now())

  @@index([userId, readAt])
}

model WorkGuide {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId   String
  project     CollabProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String          @db.VarChar(200)
  description String?         @db.VarChar(1000)
  icon        String?         @db.VarChar(32)
  category    String?         @db.VarChar(80)
  sortOrder   Int             @default(0)
  published   Boolean         @default(true)
  createdById String
  createdBy   User            @relation("WorkGuideCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  steps       WorkGuideStep[]

  @@index([projectId, sortOrder])
  @@index([workspaceId])
}

model WorkGuideStep {
  id          String    @id @default(cuid())
  guideId     String
  guide       WorkGuide @relation(fields: [guideId], references: [id], onDelete: Cascade)
  title       String    @db.VarChar(200)
  summary     String?   @db.VarChar(500)
  content     String?   @db.Text
  tips        String?   @db.VarChar(1000)
  durationMin Int?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([guideId, sortOrder])
}

enum FinanceAccountType {
  PERSONAL
  BUSINESS
  OTHER
}

enum CreditStatus {
  ACTIVE
  PAID_OFF
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  SKIPPED
}

/// Qué es la cuenta de verdad. Las cuentas de antes de la fase 1 quedan como «General» (OTHER).
enum FinanceAccountKind {
  SAVINGS
  CHECKING
  CASH
  WALLET
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum FinanceCategoryKind {
  EXPENSE
  INCOME
}

enum FinanceTxType {
  INCOME
  EXPENSE
  TRANSFER
  ADJUSTMENT
}

/// De dónde salió un movimiento. Los de la fase 2 (WhatsApp, SMS, correo, Apple Pay, extracto) ya tienen su valor.
enum FinanceTxSource {
  MANUAL
  TEXT
  SHORTCUT
  RECONCILE
  LEGACY
  IMPORT
  WHATSAPP
  SMS
  EMAIL
  APPLE_PAY
  STATEMENT
}

model FinanceAccount {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String               @db.VarChar(120)
  /// El libro: Personal, Negocio u Otro (dos libros separados).
  type                FinanceAccountType   @default(PERSONAL)
  currency            String               @default("COP") @db.VarChar(3)
  color               String?              @db.VarChar(7)
  /// Qué es de verdad: ahorros, corriente, efectivo, billetera (Nequi, Daviplata), tarjeta de crédito o inversión.
  kind                FinanceAccountKind   @default(OTHER)
  /// Banco o entidad (Bancolombia, Nequi…).
  institution         String?              @db.VarChar(60)
  /// Últimos cuatro dígitos, para reconocerla.
  last4               String?              @db.VarChar(4)
  /// Lo que tenía antes de todo lo anotado aquí (en una tarjeta de crédito, negativo = lo que debía).
  openingBalance      Decimal              @default(0) @db.Decimal(14, 2)
  /// Último cuadre con el banco: hasta ese día todo cuadra («revisado hasta aquí»), con el saldo que dijo el banco.
  reconciledAt        DateTime?            @db.Date
  reconciledBalance   Decimal?             @db.Decimal(14, 2)
  /// Momento exacto del cuadre: lo que se anote después para ese mismo día no lo daña.
  reconciledMoment    DateTime?
  incomes             Income[]
  credits             Credit[]
  /// Cuotas que se pagaron desde esta cuenta (cuando no fue la del crédito).
  installmentPayments CreditInstallment[]  @relation("InstallmentPaidFrom")
  transactions        FinanceTransaction[] @relation("FinanceTxAccount")
  transfersIn         FinanceTransaction[] @relation("FinanceTxToAccount")
  keywords            FinanceKeyword[]
  shortcuts           FinanceShortcut[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Archivada = en la papelera: no sale en listas ni en el resumen y se puede restaurar. null = activa.
  archivedAt          DateTime?

  @@index([userId])
}

/// Ingresos de antes de la fase 1. Desde la fase 1 viven en FinanceTransaction (tipo INCOME, con el mismo id); esta
/// tabla queda como respaldo y ya no se escribe.
model Income {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount      Decimal        @db.Decimal(14, 2)
  date        DateTime       @db.Date
  description String?        @db.VarChar(200)
  createdAt   DateTime       @default(now())
  /// Cuándo pasó a los movimientos (FinanceTransaction). null = falta pasarlo.
  migratedAt  DateTime?

  @@index([userId, accountId, date])
}

/// Categorías de gastos e ingresos, con subcategorías e íconos. FerFinance trae las colombianas (con `systemKey`).
model FinanceCategory {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         FinanceCategoryKind  @default(EXPENSE)
  parentId     String?
  parent       FinanceCategory?     @relation("FinanceCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     FinanceCategory[]    @relation("FinanceCategoryTree")
  name         String               @db.VarChar(60)
  /// Un emoji.
  icon         String?              @db.VarChar(16)
  color        String?              @db.VarChar(7)
  /// Clave de las que trae FerFinance (no se duplican y el texto las reconoce). null = una tuya.
  systemKey    String?              @db.VarChar(40)
  sortOrder    Int                  @default(0)
  /// Archivada = ya no sale para elegir, pero los movimientos viejos la conservan.
  archivedAt   DateTime?
  transactions FinanceTransaction[]
  keywords     FinanceKeyword[]
  shortcuts    FinanceShortcut[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, systemKey])
  @@index([userId, kind])
  @@index([parentId])
}

/// Un movimiento: ingreso, gasto, transferencia entre tus cuentas o ajuste (el cuadre con el banco).
model FinanceTransaction {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        FinanceTxType
  /// De donde sale (gasto, transferencia) o a donde entra (ingreso). En un ajuste, la cuenta ajustada.
  accountId   String
  account     FinanceAccount   @relation("FinanceTxAccount", fields: [accountId], references: [id], onDelete: Cascade)
  /// Solo en transferencias: a donde llega la plata.
  toAccountId String?
  toAccount   FinanceAccount?  @relation("FinanceTxToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  /// Siempre positivo, salvo en los ajustes (negativo = el saldo baja).
  amount      Decimal          @db.Decimal(14, 2)
  date        DateTime         @db.Date
  categoryId  String?
  category    FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant    String?          @db.VarChar(120)
  note        String?          @db.VarChar(300)
  source      FinanceTxSource  @default(MANUAL)
  /// Lo que se escribió o el aviso tal como llegó («almuerzo 18 lucas nequi»).
  rawText     String?          @db.VarChar(500)
  /// Por revisar (lo que llegue solo, en la fase 2). Lo anotado a mano nace revisado.
  needsReview Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([userId, date])
  @@index([accountId, date])
  @@index([toAccountId, date])
  @@index([categoryId])
}

/// Palabras que le enseñaste a FerFinance: «almuerzo» es Comida, «bancol» es tu cuenta de Bancolombia.
model FinanceKeyword {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// En minúsculas y sin tildes.
  keyword    String           @db.VarChar(60)
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  accountId  String?
  account    FinanceAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([userId, keyword])
}

/// «Lo de siempre»: el tinto, el almuerzo o el bus, anotados con un toque.
model FinanceShortcut {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String           @db.VarChar(40)
  icon       String?          @db.VarChar(16)
  type       FinanceTxType    @default(EXPENSE)
  amount     Decimal          @db.Decimal(14, 2)
  accountId  String
  account    FinanceAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId String?
  category   FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant   String?          @db.VarChar(120)
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([userId])
}

model Credit {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(120)
  totalAmount       Decimal             @db.Decimal(14, 2)
  installmentAmount Decimal             @db.Decimal(14, 2)
  status            CreditStatus        @default(ACTIVE)
  installments      CreditInstallment[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  /// Cuándo se revisaron las fechas de sus cuotas (los créditos viejos podían saltarse un mes si la cuota caía
  /// el 29, 30 o 31). null = falta revisar; los créditos nuevos nacen revisados.
  datesCheckedAt    DateTime?

  @@index([userId, accountId])
}

model CreditInstallment {
  id            String            @id @default(cuid())
  creditId      String
  credit        Credit            @relation(fields: [creditId], references: [id], onDelete: Cascade)
  dueDate       DateTime          @db.Date
  amount        Decimal           @db.Decimal(14, 2)
  status        InstallmentStatus @default(PENDING)
  /// Momento en que se marcó como pagada.
  paidAt        DateTime?
  /// Día real del pago (el que eligió la persona). null en pagos viejos: se usa el día de paidAt.
  paidDate      DateTime?         @db.Date
  /// Valor que se pagó de verdad. null = el valor de la cuota.
  paidAmount    Decimal?          @db.Decimal(14, 2)
  /// Cuenta de donde salió el pago. null = la cuenta del crédito.
  paidAccountId String?
  paidAccount   FinanceAccount?   @relation("InstallmentPaidFrom", fields: [paidAccountId], references: [id], onDelete: SetNull)

  @@index([creditId, dueDate])
  @@index([paidAccountId])
}

/**
 * ---------- NutriFer: comida colombiana y calorias ----------
 */

/// De donde sale un alimento.
enum FoodSource {
  /// Tabla de Composicion de Alimentos Colombianos 2018 (ICBF).
  TCAC
  /// 18 preparaciones tradicionales medidas por el ICBF y la Universidad Nacional.
  P18
  /// Plato tipico armado por partes en NutriFer.
  DISH
  /// USDA FoodData Central (respaldo).
  USDA
  /// Open Food Facts (productos empacados).
  OFF
  /// Creado por el usuario.
  USER
  /// Receta propia: ingredientes y porciones (se anota como cualquier alimento).
  RECIPE
}

/// Cómo se preparó lo que se anotó; con aceite suma sus calorías.
enum CookMethod {
  /// Cocido o al vapor: sin aceite.
  COCIDO
  /// Asado o a la plancha: un poco de aceite.
  ASADO
  /// Sudado o guisado (con hogao).
  SUDADO
  /// Frito.
  FRITO
}

/// Comidas del dia a la colombiana (los nombres se cambian en el perfil).
enum MealSlot {
  DESAYUNO
  MEDIAS_NUEVES
  ALMUERZO
  ONCES
  COMIDA
}

enum Sex {
  MALE
  FEMALE
}

enum WeightGoal {
  LOSE
  MAINTAIN
  GAIN
}

/// Un alimento con sus valores por 100 g de parte comestible.
model Food {
  id          String             @id @default(cuid())
  source      FoodSource
  /// Codigo en su fuente (codigo TCAC, fdcId, codigo de barras o clave del plato).
  sourceCode  String?            @db.VarChar(40)
  name        String             @db.VarChar(160)
  /// Nombre, alias y sinonimos normalizados (minusculas, sin tildes) para la busqueda.
  searchText  String             @db.Text
  category    String?            @db.VarChar(80)
  brand       String?            @db.VarChar(120)
  barcode     String?            @db.VarChar(32)
  kcal        Float
  protein     Float
  fat         Float
  carbs       Float
  fiber       Float?
  sugar       Float?
  satFat      Float?
  /// mg por 100 g.
  sodium      Float?
  /// Resto de nutrientes de la fuente (minerales, vitaminas, grasas), por 100 g.
  nutrients   Json?
  /// null = base compartida; si no, alimento propio de ese usuario.
  ownerId     String?
  owner       User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Fuera de la busqueda (no se borra para no romper el historial).
  archived    Boolean            @default(false)
  /// Prioridad en la busqueda: lo de todos los dias arriba, lo raro abajo (la pone el cargador).
  priority    Int                @default(0)
  /// Receta: cuántas porciones salen.
  servings    Float?
  /// Receta: lo que pesó la olla al final, si se pesó (si no, cuenta la suma de los ingredientes).
  cookedGrams Float?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  portions    FoodPortion[]
  parts       DishPart[]         @relation("DishParts")
  partOf      DishPart[]         @relation("DishPartFood")
  entries     MealEntry[]
  ingredients RecipeIngredient[] @relation("RecipeIngredients")
  usedIn      RecipeIngredient[] @relation("IngredientFood")
  favorites   FoodFavorite[]
  savedItems  SavedMealItem[]
  aliases     FoodAlias[]

  @@unique([source, sourceCode])
  @@index([ownerId])
  @@index([barcode])
}

/// Medida casera de un alimento: "1 arepa pequeña" = 56 g.
model FoodPortion {
  id        String  @id @default(cuid())
  foodId    String
  food      Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  label     String  @db.VarChar(80)
  grams     Float
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([foodId])
}

/// Parte de un plato tipico para una porcion (bandeja paisa = arroz + frijoles + chicharron + ...).
model DishPart {
  id        String @id @default(cuid())
  dishId    String
  dish      Food   @relation("DishParts", fields: [dishId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food   @relation("DishPartFood", fields: [foodId], references: [id], onDelete: Cascade)
  label     String @db.VarChar(80)
  grams     Float
  sortOrder Int    @default(0)

  @@index([dishId])
}

/// Lo que se anoto en una comida. Guarda una copia de los valores: si el alimento cambia, el historial no.
model MealEntry {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  meal         MealSlot
  foodId       String?
  food         Food?       @relation(fields: [foodId], references: [id], onDelete: SetNull)
  name         String      @db.VarChar(160)
  /// Medida usada ("arepa pequeña"); null si se anoto en gramos.
  portionLabel String?     @db.VarChar(80)
  /// Gramos de una unidad de esa medida.
  portionGrams Float?
  quantity     Float       @default(1)
  grams        Float?
  kcal         Float
  protein      Float
  fat          Float
  carbs        Float
  fiber        Float?
  sugar        Float?
  sodium       Float?
  /// Plato por partes: [{ label, foodId, grams, included }] tal como se anoto.
  parts        Json?
  /// Registro rapido: solo calorias (y macros si se quiere), sin alimento.
  quick        Boolean     @default(false)
  /// Como se preparo; el aceite ya va sumado en las calorias.
  prep         CookMethod?
  oilGrams     Float?
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, date])
  @@index([userId, foodId])
}

/// Ingrediente de una receta propia, con la cantidad que lleva la olla entera.
model RecipeIngredient {
  id           String  @id @default(cuid())
  recipeId     String
  recipe       Food    @relation("RecipeIngredients", fields: [recipeId], references: [id], onDelete: Cascade)
  foodId       String
  food         Food    @relation("IngredientFood", fields: [foodId], references: [id], onDelete: Cascade)
  portionLabel String? @db.VarChar(80)
  quantity     Float   @default(1)
  grams        Float
  sortOrder    Int     @default(0)

  @@index([recipeId])
  @@index([foodId])
}

/// Alimento marcado con estrella para tenerlo a mano.
model FoodFavorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, foodId])
  @@index([foodId])
}

/// Comida guardada («Mi desayuno de semana», «Corrientazo») para anotarla completa de un toque.
model SavedMeal {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String          @db.VarChar(80)
  /// Comida donde se guardo (sale primero ahi).
  meal       MealSlot?
  lastUsedAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      SavedMealItem[]

  @@index([userId])
}

/// Lo que lleva una comida guardada; mismos campos que una anotacion (se recalcula al anotarla).
model SavedMealItem {
  id           String      @id @default(cuid())
  savedMealId  String
  savedMeal    SavedMeal   @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
  foodId       String?
  food         Food?       @relation(fields: [foodId], references: [id], onDelete: SetNull)
  quick        Boolean     @default(false)
  name         String      @db.VarChar(160)
  portionLabel String?     @db.VarChar(80)
  portionGrams Float?
  quantity     Float       @default(1)
  grams        Float?
  kcal         Float
  protein      Float
  fat          Float
  carbs        Float
  fiber        Float?
  sugar        Float?
  sodium       Float?
  parts        Json?
  prep         CookMethod?
  oilGrams     Float?
  sortOrder    Int         @default(0)

  @@index([savedMealId])
  @@index([foodId])
}

/// Lo del dia que no es una comida: por ahora, el agua.
model NutritionDay {
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  waterMl Int      @default(0)

  @@id([userId, date])
}

/// Nombre propio aprendido: cuando el usuario corrige que alimento era una frase («mi arepita» = Arepa de maiz...).
model FoodAlias {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Frase normalizada (minusculas, sin tildes).
  phrase    String   @db.VarChar(120)
  foodId    String
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  uses      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, phrase])
  @@index([foodId])
}

/// Foto de una comida para anotarla despues (se borra al completarla).
model MealPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  meal      MealSlot
  mime      String   @db.VarChar(40)
  data      Bytes    @db.MediumBlob
  note      String?  @db.VarChar(200)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/// Datos para calcular la meta, y preferencias de NutriFer.
model NutritionProfile {
  userId        String     @id
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sex           Sex
  birthYear     Int
  heightCm      Float
  weightKg      Float
  /// Factor de actividad (1.2 sedentario ... 1.9 muy activo).
  activity      Float
  goal          WeightGoal @default(MAINTAIN)
  /// Kilos por semana para bajar o subir.
  ratePerWeek   Float      @default(0.5)
  kcalTarget    Int
  proteinTarget Int
  fatTarget     Int
  carbsTarget   Int
  /// true = metas puestas a mano (no se recalculan).
  manual        Boolean    @default(false)
  /// Nombres propios de las comidas, p. ej. {"ONCES": "Algo"}.
  mealNames     Json?
  /// Meta de agua al dia y tamaño del vaso (null = 2.000 ml y 250 ml).
  waterGoalMl   Int?
  glassMl       Int?
  /// Meta que se ajusta sola: cada lunes se revisa con el peso de tendencia y, con datos suficientes, con el gasto real.
  adaptive      Boolean    @default(true)
  /// Ayuno: horas de la meta (16 = 16:8) y si avisar al llegar.
  fastGoalHours Int        @default(16)
  fastNotify    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum WeightSource {
  MANUAL
  /// Lo mandó el atajo de iOS (Apple Salud).
  SHORTCUT
}

/// Peso del día (uno por día: el último que llega gana).
model BodyWeight {
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  kg        Float
  source    WeightSource @default(MANUAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@id([userId, date])
}

/// Revisión semanal de la meta: el gasto con la fórmula, el observado con el peso y lo comido, y el que se usó.
model EnergyEstimate {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Lunes de la semana revisada.
  weekStart   DateTime @db.Date
  /// Gasto usado para la meta (kcal al día).
  tdee        Int
  /// Gasto con la fórmula (Mifflin-St Jeor × actividad).
  formula     Int
  /// Gasto observado: ingesta media − 7.700 × cambio de la tendencia ÷ días (null = aún sin datos suficientes).
  observed    Int?
  intakeAvg   Int?
  trendChange Float?
  loggedDays  Int      @default(0)
  spanDays    Int      @default(0)
  weightKg    Float
  kcalBefore  Int
  kcalTarget  Int
  createdAt   DateTime @default(now())

  @@id([userId, weekStart])
}

/// Llave del atajo de iOS que manda el peso desde Apple Salud (solo se guarda su huella SHA-256).
model NutritionShortcut {
  userId     String    @id
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  /// Los últimos 4 caracteres, para reconocerla.
  hint       String    @db.VarChar(8)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

/// Llave para que un asistente (Claude) lea el informe de NutriFer: solo lectura, nunca cambia nada.
/// Se guarda su huella SHA-256; la llave se muestra una sola vez.
model NutritionAgentKey {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Para reconocerla («Claude en el PC»).
  name       String    @db.VarChar(60)
  tokenHash  String    @unique @db.Char(64)
  /// Los últimos 4 caracteres, para reconocerla.
  hint       String    @db.VarChar(8)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Un ayuno: empieza y termina (endedAt null = en curso). Cuenta para la racha si llegó a su meta.
model Fast {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  endedAt    DateTime?
  /// Horas de la meta con que empezó (16, 18…).
  goalHours  Int
  /// Ya se avisó que llegó a la meta.
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, startedAt])
}

enum PlanKind {
  /// Una comida guardada.
  SAVED
  /// Una receta propia (en porciones).
  RECIPE
  /// Un alimento (en su medida por defecto).
  FOOD
}

/// Plan de la semana: qué se va a comer cada día y comida (sirve para la lista de mercado).
model MealPlanItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  meal      MealSlot
  kind      PlanKind
  /// Id de la comida guardada, la receta o el alimento.
  refId     String   @db.VarChar(40)
  /// Cuántas: porciones de la receta, veces la comida guardada o medidas del alimento.
  servings  Float    @default(1)
  createdAt DateTime @default(now())

  @@index([userId, date])
}

/* ---------------------------------------------------------------------------
   FerFit: ejercicio en casa. Los ejercicios y las rutinas listas viven en el código
   (api/src/fit/data), y aquí se guardan por su clave.
   --------------------------------------------------------------------------- */

/// Una rutina propia (armada o copiada de una rutina lista).
model FitRoutine {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String           @db.VarChar(80)
  notes      String?          @db.VarChar(500)
  /// Circuito: los ejercicios seguidos, una serie de cada uno, y se repite `rounds` veces.
  circuit    Boolean          @default(false)
  rounds     Int              @default(1)
  /// La rutina lista de la que salió, por su clave.
  sourceKey  String?          @db.VarChar(60)
  /// Borrada: sale de la lista pero el historial la conserva.
  archived   Boolean          @default(false)
  lastDoneAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  items      FitRoutineItem[]

  @@index([userId])
}

/// Un ejercicio de una rutina propia, con sus series y repeticiones (o segundos) y el descanso.
model FitRoutineItem {
  id          String     @id @default(cuid())
  routineId   String
  routine     FitRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// Clave del ejercicio en la biblioteca (api/src/fit/data/exercises.ts).
  exerciseKey String     @db.VarChar(60)
  sets        Int        @default(3)
  /// Repeticiones por serie; null si va por tiempo.
  reps        Int?
  /// Segundos por serie; null si va por repeticiones.
  seconds     Int?
  restSeconds Int        @default(45)
  sortOrder   Int        @default(0)

  @@index([routineId])
}

enum FitWorkoutKind {
  /// Una rutina (propia o lista), con sus ejercicios.
  ROUTINE
  /// Otra actividad: caminar, bici, fútbol…
  ACTIVITY
}

/// Lo que se chuleó un día: una rutina (completa o ejercicio por ejercicio) o una actividad suelta.
model FitWorkout {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime       @db.Date
  kind      FitWorkoutKind
  /// La rutina propia, si fue una.
  routineId String?        @db.VarChar(30)
  /// La rutina lista, por su clave, si fue una.
  readyKey  String?        @db.VarChar(60)
  /// El nombre de ese momento (la rutina puede cambiar o borrarse después).
  name      String         @db.VarChar(80)
  /// Actividad suelta: caminar, bici, futbol, nadar, bailar u otra.
  activity  String?        @db.VarChar(30)
  minutes   Int?
  /// Los ejercicios de la rutina con lo que se hizo: [{ key, name, sets, reps, seconds, done }].
  items     Json?
  /// Hecha completa.
  completed Boolean        @default(false)
  note      String?        @db.VarChar(300)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, date])
}

/// Ajustes de FerFit.
model FitSettings {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Días a la semana para cumplir la meta (la racha cuenta semanas cumplidas).
  weeklyGoalDays Int      @default(3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
