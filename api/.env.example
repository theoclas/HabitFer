# Produccion — no usar credenciales de desarrollo
# Copiar a .env.prod y completar con secrets fuertes

PORT=4001
NODE_ENV=production
DATABASE_URL=mysql://USER:STRONG_PASSWORD@db:3306/habitfer
JWT_SECRET=genera_un_secreto_aleatorio_de_al_menos_32_caracteres

# Origen del frontend (debe coincidir con la URL publica)
# Sin dominio:  http://TU_IP:8080
# Con dominio:  https://habitfer.tudominio.com
CORS_ORIGINS=http://TU_IP:8080

# Cookies secure en HTTPS. En HTTP (solo IP:8080) usar false:
COOKIE_SECURE=false

# Aplicar schema al arrancar el contenedor (default true)
PRISMA_DB_PUSH=true

# Notificaciones push (Web Push). Sin estas llaves la app funciona, pero no envia push.
# Generarlas una vez con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://habitfer.tudominio.com

# Coach semanal con Claude (opcional). Sin la llave el coach queda apagado.
ANTHROPIC_API_KEY=

# Avisos por correo (opcional). Sin SMTP_USER y SMTP_PASS quedan apagados.
# Hostinger: smtp.hostinger.com, 465 con SSL, el buzon completo como usuario.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@tudominio.com
SMTP_PASS=
MAIL_FROM="HabitFer <no-reply@tudominio.com>"
# Direccion publica de la app, para los botones de los correos.
APP_URL=https://habitfer.tudominio.com
