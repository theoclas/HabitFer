# Copiar a .env en la raiz del proyecto (junto a docker-compose.prod.yml):
#   cp .env.prod.example .env

# --- MySQL (contenedor db) ---
MYSQL_ROOT_PASSWORD=cambia_esto_root_muy_largo
MYSQL_USER=habitfer
MYSQL_PASSWORD=cambia_esto_db_muy_largo

# --- Zona horaria de la API ---
# "Hoy", las rachas y la hora de los recordatorios usan este huso. Default: America/Bogota.
# TZ=America/Bogota

# --- Frontend (build-time) ---
# Recomendado: ruta relativa. La web y la API van detras del mismo Caddy, asi que
# funciona igual por la IP (http://TU_IP:8080) y por el dominio con HTTPS.
VITE_API_URL=/api

# Alternativas con direccion completa:
# VITE_API_URL=http://TU_IP_VPS:8080/api
# VITE_API_URL=https://habitfer.tudominio.com/api

# --- Caddy (reverse proxy de HabitFer) ---
# Puerto publico en el host. 8080 evita conflicto con Dashboard en :80
CADDY_HTTP_PORT=8080

# Ruta al Caddyfile: deploy/Caddyfile (HTTP) o deploy/Caddyfile.domain (HTTPS)
CADDYFILE=./deploy/Caddyfile

# Solo si usas Caddyfile.domain (HTTPS directo en este compose):
# DOMAIN=habitfer.tudominio.com
# CADDY_HTTP_PORT=80
# CADDYFILE=./deploy/Caddyfile.domain

# --- Avisos por WhatsApp (servicio wa: un celular vinculado, como WhatsApp Web) ---
# Token interno entre la api y wa (no sale del servidor). Generarlo una vez con:  openssl rand -hex 24
# Sin token, WhatsApp queda apagado y lo demas funciona igual.
# WA_TOKEN=
